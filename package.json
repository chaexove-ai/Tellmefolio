{
  "name": "tellmefolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "tpl:prepare": "node scripts/prepare-template.mjs",
    "tpl:check": "node scripts/check-template.ts",
    "eval:evidence": "node --experimental-transform-types --no-warnings scripts/eval/show-evidence.ts",
    "eval:validate": "node --experimental-transform-types --no-warnings scripts/eval/validate.ts",
    "eval": "node --experimental-transform-types --no-warnings scripts/eval/run.ts",
    "eval:estimate": "node --experimental-transform-types --no-warnings scripts/eval/estimate.ts",
    "eval:judge": "node --experimental-transform-types --no-warnings scripts/eval/judge.ts",
    "eval:score": "node --experimental-transform-types --no-warnings scripts/eval/score.ts",
    "eval:review": "node --experimental-transform-types --no-warnings scripts/eval/review.ts",
    "eval:unit": "node --experimental-transform-types --no-warnings scripts/eval/unit.ts",
    "eval:selftest": "node --experimental-transform-types --no-warnings scripts/eval/selftest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "yaml": "^2.9.1"
  }
}
